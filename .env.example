APP_ENV=development
HTTP_ADDR=:8080
# Migrations and seeding use the owner/superuser connection.
MIGRATE_DATABASE_URL=postgres://waypoint:waypoint@localhost:5433/waypoint?sslmode=disable
# The API uses a non-superuser role so PostgreSQL RLS is actually enforced.
DATABASE_URL=postgres://waypoint_app:waypoint_app@localhost:5433/waypoint?sslmode=disable
REDIS_URL=redis://localhost:6380/0
NATS_URL=nats://localhost:4222
JWT_SECRET=replace-me-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
LOG_LEVEL=info
SMTP_ADDR=localhost:1025
